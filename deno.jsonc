{
  "name": "@zanix/core",
  "version": "1.1.0",
  "nodeModulesDir": "auto",
  "zanix": {
    "project": "library",
    "hash": "pn287r"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "jsr"
      ],
      "include": [
        "eqeqeq",
        "default-param-last",
        "camelcase",
        "no-await-in-loop",
        "no-const-assign",
        "no-eval",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename"
      ]
    },
    "exclude": [
      ".dist"
    ],
    "plugins": [
      "jsr:@zanix/utils/linter/deno-zanix-plugin"
    ],
    "report": "pretty"
  },
  "fmt": {
    "exclude": [
      ".dist"
    ],
    "proseWrap": "always",
    "indentWidth": 2,
    "singleQuote": true,
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": false
  },
  "imports": {
    "@std/path": "jsr:@std/path@0.224",
    "@std/assert": "jsr:@std/assert@0.224",
    "@std/testing": "jsr:@std/testing@1.0.9",
    "@zanix/admin": "jsr:@zanix/admin@^1.1.0",
    "@zanix/app": "jsr:@zanix/app@^0.1.0",
    "@zanix/app/runtime": "jsr:@zanix/app@^0.1.0/runtime",
    "@zanix/server": "jsr:@zanix/server@^3.2.0",
    "@zanix/asyncmq/core": "jsr:@zanix/asyncmq@^0.6.0/core",
    "@zanix/asyncmq/jobs": "jsr:@zanix/asyncmq@^0.6.0",
    "@zanix/asyncmq/worker": "jsr:@zanix/asyncmq@^0.6.0/worker",
    "@zanix/notifications": "jsr:@zanix/notifications@^0.4.0",
    "@zanix/notifications/core": "jsr:@zanix/notifications@^0.4.0/core",
    "@zanix/database": "jsr:@zanix/datamaster@^1.3.0",
    "@zanix/datamaster/core": "jsr:@zanix/datamaster@^1.3.0/core",
    "@zanix/datamaster/observability": "jsr:@zanix/datamaster@^1.3.0/observability",
    "@zanix/logger": "jsr:@zanix/utils@^2.6.0/logger",
    "@zanix/errors": "jsr:@zanix/utils@^2.6.0/errors",
    "@zanix/helpers": "jsr:@zanix/utils@^2.6.0/helpers",
    "@zanix/helpers/files": "jsr:@zanix/utils@^2.6.0/helpers",
    "@zanix/types": "jsr:@zanix/utils@^2.6.0/types",
    "@zanix/validator": "jsr:@zanix/utils@^2.6.0/validator",
    "@zanix/auth": "jsr:@zanix/auth@^0.7.0",
    "@zanix/auth/core": "jsr:@zanix/auth@^0.7.0/core",
    "typings/": "./src/typings/",
    "utils/": "./src/utils/",
    "modules/": "./src/modules/"
  },
  "exports": {
    ".": "./mod.ts"
  },
  "publish": {
    "exclude": [
      ".github",
      "src/@tests"
    ]
  },
  "test": {
    "include": [
      "src/@tests/**/*.test.ts"
    ]
  }
}

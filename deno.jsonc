{
  "name": "@zanix/core",
  "version": "2.0.0",
  "nodeModulesDir": "auto",
  "zanix": {
    "project": "library"
  },
  "links": [],
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "jsr"
      ],
      "include": [
        "eqeqeq",
        "default-param-last",
        "camelcase",
        "no-await-in-loop",
        "no-const-assign",
        "no-eval",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename"
      ]
    },
    "exclude": [
      ".dist"
    ],
    "plugins": [
      "jsr:@zanix/utils@^3.0.0/linter/deno-zanix-plugin"
    ],
    "report": "pretty"
  },
  "fmt": {
    "exclude": [
      ".dist"
    ],
    "proseWrap": "always",
    "indentWidth": 2,
    "singleQuote": true,
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": false
  },
  "imports": {
    "@std/path": "jsr:@std/path@0.224",
    "@std/assert": "jsr:@std/assert@0.224",
    "@std/testing": "jsr:@std/testing@1.0.9",
    "@zanix/admin": "jsr:@zanix/admin@^2.0.0",
    "@zanix/app": "jsr:@zanix/app@^0.2.0",
    "@zanix/app/runtime": "jsr:@zanix/app@^0.2.0/runtime",
    "@zanix/server": "jsr:@zanix/server@^3.4.0",
    "@zanix/asyncmq/core": "jsr:@zanix/asyncmq@^0.7.0/core",
    "@zanix/asyncmq/jobs": "jsr:@zanix/asyncmq@^0.7.0",
    "@zanix/asyncmq/worker": "jsr:@zanix/asyncmq@^0.7.0/worker",
    "@zanix/notifications": "jsr:@zanix/notifications@^0.5.0",
    "@zanix/notifications/core": "jsr:@zanix/notifications@^0.5.0/core",
    "@zanix/notifications/templates-api": "jsr:@zanix/notifications@^0.5.0/templates-api",
    "@zanix/database": "jsr:@zanix/datamaster@^1.5.0",
    "@zanix/datamaster/core": "jsr:@zanix/datamaster@^1.5.0/core",
    "@zanix/datamaster/triggers-api": "jsr:@zanix/datamaster@^1.5.0/triggers-api",
    "@zanix/datamaster/dlq-api": "jsr:@zanix/datamaster@^1.5.0/dlq-api",
    "@zanix/datamaster/observability": "jsr:@zanix/datamaster@^1.5.0/observability",
    "@zanix/datamaster/storage": "jsr:@zanix/datamaster@^1.5.0/storage",
    "@zanix/datamaster/files": "jsr:@zanix/datamaster@^1.5.0/files",
    "@zanix/space/assets-api": "jsr:@zanix/space@^0.1.0/assets-api",
    "@zanix/logger": "jsr:@zanix/utils@^3.1.2/logger",
    "@zanix/errors": "jsr:@zanix/utils@^3.1.2/errors",
    "@zanix/helpers": "jsr:@zanix/utils@^3.1.2/helpers",
    "@zanix/helpers/files": "jsr:@zanix/utils@^3.1.2/helpers",
    "@zanix/types": "jsr:@zanix/utils@^3.1.2/types",
    "@zanix/validator": "jsr:@zanix/utils@^3.1.2/validator",
    "@zanix/auth": "jsr:@zanix/auth@^0.8.0",
    "@zanix/auth/core": "jsr:@zanix/auth@^0.8.0/core",
    "typings/": "./src/typings/",
    "utils/": "./src/utils/",
    "modules/": "./src/modules/"
  },
  "exports": {
    ".": "./mod.ts"
  },
  "publish": {
    "exclude": [
      ".github",
      "src/@tests"
    ]
  },
  "test": {
    "include": [
      "src/@tests/**/*.test.ts"
    ]
  }
}

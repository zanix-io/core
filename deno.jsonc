{
  "name": "@zanix/core",
  "version": "3.1.0",
  "nodeModulesDir": "auto",
  "zanix": {
    "project": "library"
  },
  "links": [],
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "jsr"
      ],
      "include": [
        "eqeqeq",
        "default-param-last",
        "camelcase",
        "no-await-in-loop",
        "no-const-assign",
        "no-eval",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename"
      ]
    },
    "exclude": [
      ".dist"
    ],
    "plugins": [
      "jsr:@zanix/utils@^4.0.0/linter/deno-zanix-plugin"
    ],
    "report": "pretty"
  },
  "fmt": {
    "exclude": [
      ".dist"
    ],
    "proseWrap": "always",
    "indentWidth": 2,
    "singleQuote": true,
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": false
  },
  "imports": {
    "@std/path": "jsr:@std/path@0.224",
    "@std/assert": "jsr:@std/assert@0.224",
    "@std/testing": "jsr:@std/testing@1.0.9",
    "@zanix/admin": "jsr:@zanix/admin@^2.3.0",
    "@zanix/admin/hub": "jsr:@zanix/admin@^2.3.0/zanix-admin-hub",
    // Floor pinned at `0.2.1`, not `^0.2.0`: the real published `@zanix/app@0.2.0` still internally
    // pinned `@zanix/server@^3.4.0` (the pre-split version, bundling `graphql`/`amqplib`
    // unconditionally in its webserver/discovery machinery) — confirmed fixed in `0.2.1`
    // specifically, via a real, isolated `deno info --json --min-dep-age=0` repro against each
    // version directly (`0.2.0` still resolves `amqplib`/`graphql`/`mongoose`/`redis` from
    // `/runtime` alone; `0.2.1` resolves none of them). `^0.2.1` still accepts a future `0.2.x`
    // patch release, it just excludes the one specific version with the bug.
    "@zanix/app": "jsr:@zanix/app@^0.2.1",
    "@zanix/app/runtime": "jsr:@zanix/app@^0.2.1/runtime",
    "@zanix/server": "jsr:@zanix/server@^4.0.0",
    "@zanix/server/graphql": "jsr:@zanix/server@^4.0.0/graphql",
    // Deliberately absent: `@zanix/asyncmq/core`/`@zanix/notifications/core`/`@zanix/datamaster/core`/
    // `@zanix/auth/core` — no file in this package imports any of them directly. Each is reached
    // through its own lazy, non-literal `*_CORE_SPECIFIER` constant in `modules/lazy/specifiers.ts`
    // instead (see that file's own doc and `defineCoreMetadata`'s own doc, `utils/metadata.ts`).
    "@zanix/asyncmq/jobs": "jsr:@zanix/asyncmq@^0.8.0/jobs",
    "@zanix/asyncmq/worker": "jsr:@zanix/asyncmq@^0.8.0/worker",
    "@zanix/notifications/templates-api": "jsr:@zanix/notifications@^1.0.0/templates-api",
    "@zanix/datamaster/database": "jsr:@zanix/datamaster@^1.9.0/database",
    "@zanix/datamaster/dlq": "jsr:@zanix/datamaster@^1.9.0/dlq",
    "@zanix/datamaster/triggers-api": "jsr:@zanix/datamaster@^1.9.0/triggers-api",
    "@zanix/datamaster/dlq-api": "jsr:@zanix/datamaster@^1.9.0/dlq-api",
    "@zanix/datamaster/observability": "jsr:@zanix/datamaster@^1.9.0/observability",
    "@zanix/logger": "jsr:@zanix/utils@^4.0.0/logger",
    "@zanix/errors": "jsr:@zanix/utils@^4.0.0/errors",
    "@zanix/helpers": "jsr:@zanix/utils@^4.0.0/helpers",
    "@zanix/types": "jsr:@zanix/utils@^4.0.0/types",
    "@zanix/validator": "jsr:@zanix/utils@^4.0.0/validator",
    // Deliberately absent: the bare `@zanix/auth` root — no file in this package imports it
    // directly either (only its own `/core`, itself reached lazily — see the note above).
    "typings/": "./src/typings/",
    "utils/": "./src/utils/",
    "modules/": "./src/modules/"
  },
  "scopes": {
    // `@zanix/space/assets-api`/`@zanix/datamaster/storage`/`/files`/`@zanix/notifications` (bare
    // root) are deliberately absent from the top-level `imports` map above (see
    // `modules/lazy/specifiers.ts`'s own doc) — this package's own test suite still needs the real,
    // precise types/values (`AssetService`, `TEMPLATES_BACKEND_ENV`/`TEMPLATES_MODEL_ENV`, mainly)
    // to assert against what `setup()`/`start()` actually build, without reintroducing the
    // materialization problem for any real consumer: a `scopes` entry only applies to files whose
    // own path falls under this prefix, so it never affects `@zanix/core`'s published surface.
    "./src/@tests/": {
      "@zanix/space/assets-api": "jsr:@zanix/space@^1.1.0/assets-api",
      "@zanix/datamaster/storage": "jsr:@zanix/datamaster@^1.9.0/storage",
      "@zanix/datamaster/files": "jsr:@zanix/datamaster@^1.9.0/files",
      "@zanix/datamaster/cache": "jsr:@zanix/datamaster@^1.9.0/cache",
      "@zanix/notifications": "jsr:@zanix/notifications@^1.0.0"
    }
  },
  "exports": {
    ".": "./mod.ts",
    // `Zanix` on its own, apart from root `.`'s neighboring admin-domain re-exports (see
    // `src/modules/zanix.ts`'s own doc) — a caller that wants ONLY the "just embed Zanix" shortcut
    // should import this instead of root.
    "./bootstrap": "./src/modules/zanix.ts"
  },
  "publish": {
    "exclude": [
      ".github",
      "src/@tests"
    ]
  },
  "test": {
    "include": [
      "src/@tests/**/*.test.ts"
    ]
  }
}

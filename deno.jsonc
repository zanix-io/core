{
  "name": "@zanix/core",
  "version": "0.3.0",
  "nodeModulesDir": "auto",
  "zanix": {
    "project": "library",
    "hash": "pn287r"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "jsr"
      ],
      "include": [
        "eqeqeq",
        "default-param-last",
        "camelcase",
        "no-await-in-loop",
        "no-const-assign",
        "no-eval",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename"
      ]
    },
    "exclude": [
      ".dist"
    ],
    "plugins": [
      "jsr:@zanix/utils/linter/deno-zanix-plugin"
    ],
    "report": "pretty"
  },
  "fmt": {
    "exclude": [
      ".dist"
    ],
    "proseWrap": "always",
    "indentWidth": 2,
    "singleQuote": true,
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": false
  },
  "imports": {
    "@std/path": "jsr:@std/path@0.224",
    "@std/assert": "jsr:@std/assert@0.224",
    "@std/testing": "jsr:@std/testing@1.0.9",
    "@zanix/admin": "jsr:@zanix/admin@^0.1.1",
    "@zanix/server": "jsr:@zanix/server@^2.1.1",
    "@zanix/asyncmq/core": "jsr:@zanix/asyncmq@^0.4.0/core",
    "@zanix/asyncmq/jobs": "jsr:@zanix/asyncmq@^0.4.0",
    "@zanix/asyncmq/worker": "jsr:@zanix/asyncmq@^0.4.0/worker",
    "@zanix/notifications": "jsr:@zanix/notifications@^0.2.3",
    "@zanix/notifications/core": "jsr:@zanix/notifications@^0.2.3/core",
    "@zanix/database": "jsr:@zanix/datamaster@^0.8.1/database",
    "@zanix/datamaster/core": "jsr:@zanix/datamaster@^0.8.1/core",
    "@zanix/datamaster/observability": "jsr:@zanix/datamaster@^0.8.1/observability",
    "@zanix/logger": "jsr:@zanix/utils@^2.4.3/logger",
    "@zanix/errors": "jsr:@zanix/utils@^2.4.3/errors",
    "@zanix/helpers": "jsr:@zanix/utils@^2.4.3/helpers",
    "@zanix/types": "jsr:@zanix/utils@^2.4.3/types",
    "@zanix/validator": "jsr:@zanix/utils@^2.4.3/validator",
    "@zanix/auth": "jsr:@zanix/auth@^0.5.0",
    "@zanix/auth/core": "jsr:@zanix/auth@^0.5.0/core",
    "typings/": "./src/typings/",
    "utils/": "./src/utils/",
    "modules/": "./src/modules/"
  },
  "exports": {
    ".": "./mod.ts"
  },
  "publish": {
    "exclude": [
      ".github",
      "src/@tests"
    ]
  },
  "test": {
    "include": [
      "src/@tests/**/*.test.ts"
    ]
  }
}
